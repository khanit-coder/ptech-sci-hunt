# ==============================================================================
# PTECH-Sci : Secret Item Hunt - Environment Variables Example
# ==============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Backend / Cloudflare Worker ONLY - DO NOT expose on frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# College External Student API Configuration (Optional)
VITE_EXTERNAL_STUDENT_API_URL=https://api.ptech.ac.th/students
VITE_EXTERNAL_STUDENT_API_KEY=your-student-api-token-here

# Cloudflare Configuration
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
